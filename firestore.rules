rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private per-account data: users/{uid}, users/{uid}/favorites/*
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public feed: every signed-in user can read all posts in real time,
    // but can only create / delete their own.
    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 280
        && request.resource.data.createdAt == request.time
        && (request.resource.data.get('imageBase64', null) == null
            || request.resource.data.imageBase64.size() < 800000);

      allow update: if false;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
